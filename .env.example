# URL pública da aplicação (ex: https://nortetecnologia.com ou https://seu-projeto.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Supabase — Chave pública (anon key) — pode ser exposta no frontend
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — Chave secreta (service_role) — NUNCA expor no frontend ou no Git
SUPABASE_SECRET_KEY=

# Cloudinary — Cloud name (pode ser público)
CLOUDINARY_CLOUD_NAME=

# Cloudinary — API Key (pode ser público)
CLOUDINARY_API_KEY=

# Cloudinary — API Secret — NUNCA expor no frontend ou no Git
CLOUDINARY_API_SECRET=

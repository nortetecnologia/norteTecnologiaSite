# URL publica da aplicacao (ex: https://nortetecnologia.com ou https://seu-projeto.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Supabase — URL do projeto
NEXT_PUBLIC_SUPABASE_URL=

# Supabase — Publishable key (substitui a antiga anon key) — segura para o frontend com RLS ativo
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — Secret key (substitui a antiga service_role) — NUNCA expor no frontend ou no Git
SUPABASE_SECRET_KEY=

# Cloudinary — Cloud name (pode ser publico)
CLOUDINARY_CLOUD_NAME=

# Cloudinary — API Key (pode ser publico)
CLOUDINARY_API_KEY=

# Cloudinary — API Secret — NUNCA expor no frontend ou no Git
CLOUDINARY_API_SECRET=